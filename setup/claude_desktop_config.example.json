{
  "mcpServers": {
    "excel-mcp-server": {
      "command": "/path/to/excel-mcp-server/.venv/bin/python",
      "args": [
        "-m",
        "excel_mcp.__main__",
        "stdio"
      ],
      "env": {
        "FASTMCP_HOST": "0.0.0.0",
        "FASTMCP_PORT": "8017",
        "EXCEL_FILES_PATH": "./excel_files"
      }
    }
  }
}

